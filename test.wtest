import plagas.cucaracha.*
import plagas.mosquito.*
import barrio.*
import elementos.Hogar.*
import elementos.huerta.*
import elementos.mascota.*

describe " test de cuando es bueno o malo un hogar." {
  test "hogar es bueno" {
        const casa1 = new Hogar ( mugre= 2 , confort = 5)

        assert.that(casa1.esBueno())
  }

  test "hogar no es bueno" {
    
        const casa2 = new Hogar (mugre= 2, confort = 2)

        assert.notThat(casa2.esBueno())
  }
}

describe "test de cuando una mascota es buena o no" {
  test "mascota es buena" {
    
        const mascota1 = new Mascota(salud = 300)

        assert.that(mascota1.esBueno())
  }

  test "mascota no es buena" {
    
        const mascota2 = new Mascota( salud=250 )

        assert.notThat(mascota2.esBueno())
}
}

describe "test de cuando una huerta es buena o no" {
    
  test "huerta que es buena" {

        const huerta1 = new Huerta( produccion = 500)

        mercado.nivelMinimoProduccion(400)

        assert.that(huerta1.esBueno())
  }

  test "huerta que no es buena" {

        const huerta2 = new Huerta( produccion = 200)

        mercado.nivelMinimoProduccion(400)

        assert.notThat(huerta2.esBueno())  
  }
}

describe " test de barrio si es copado o no" {

      const huerta1 = new Huerta( produccion = 500)
      const huerta2 = new Huerta( produccion = 200)
      const mascota1 = new Mascota(salud = 300)
      const mascota2 = new Mascota( salud=250 )
      const casa1 = new Hogar ( mugre= 2 , confort = 5)
      
  test " es copado el barrio " {

      
      const berazategui = new Barrio(elementos= [huerta1,huerta2,casa1] ) 

      assert.that(berazategui.esCopado())

  }

  test "no es copado el barrio" {
    
      const quilmes = new Barrio(elementos=[huerta2,mascota2,casa1])

      assert.that(quilmes.esCopado())
  }
}

describe " plagas " {
  test "nivel de daño de plaga de mosquitos " {
      
      const plagaMosquitos = new Mosquito(poblacion = 63)

      assert.equals(63, plagaMosquitos.dano())

  }

  test " plaga de cucarachas puede transmitir enfermedad" {
      
      const plagaCucarachas = new Cucaracha(poblacion = 200 , pesoPromedio = 20)

      assert.that(plagaCucarachas.puedeTransmitirEnfermedad())
  }

  test "plaga cucarachas no puede transmitir enfermedad por peso promedio" {
    
      const plagaCucarachas = new Cucaracha(poblacion = 200 , pesoPromedio = 8)

      assert.notThat(plagaCucarachas.puedeTransmitirEnfermedad())
  }
}
